<Window x:Class="MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MVVM.ViewModel"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <!--Step 1: Wiring the view model to this window -->
    <Window.DataContext>
        <vm:StudentViewModel/>
    </Window.DataContext>
    <Grid>
       
        <StackPanel Margin="20">
            <TextBlock Text="Student Manager" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
            <!--ListBox displays the ObservableCollection -->
            <ListBox ItemsSource="{Binding Students}" Height="200" Margin="0,0,0,15">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"></TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Label>Name:</Label>
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
            Width="300" Padding="5" Margin="0,0,0,5"
            HorizontalAlignment="Left"/>
        </StackPanel>
        
    </Grid>
</Window>
